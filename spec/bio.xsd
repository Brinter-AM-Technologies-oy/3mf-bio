<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns="https://3mfbio.com/ns/bio/2026/07"
	xmlns:xs="http://www.w3.org/2001/XMLSchema"
	xmlns:core="http://schemas.microsoft.com/3dmanufacturing/core/2015/02"
	targetNamespace="https://3mfbio.com/ns/bio/2026/07"
	elementFormDefault="unqualified" attributeFormDefault="unqualified" blockDefault="#all">
	<xs:import namespace="http://www.w3.org/XML/1998/namespace"
		schemaLocation="http://www.w3.org/2001/xml.xsd"/>
	<xs:annotation>
		<xs:documentation><![CDATA[   Schema notes:

  Items within this schema follow a simple naming convention of appending a prefix indicating the type of element for references:

  Unprefixed: Element names
  CT_: Complex types
  ST_: Simple types

  Bio extension notes:

  Every <param> carries a mandatory provenance attribute. Where provenance is "cited" or
  "derived", the parameter MUST reference an <evidence> resource. This constraint cannot be
  expressed in XSD 1.0 and is enforced by consumers; see Chapter 8 of the specification and
  the reference validator.

  An attribute present with an empty value denotes "declared but not yet known" and is
  distinct from an absent attribute. Constrained simple types therefore union with the
  zero-length string.
  ]]></xs:documentation>
	</xs:annotation>

	<!-- Complex Types -->

	<xs:complexType name="CT_Resources">
		<xs:sequence>
			<xs:choice minOccurs="0" maxOccurs="2147483647">
				<xs:element ref="evidence" minOccurs="0" maxOccurs="2147483647"/>
				<xs:element ref="substances" minOccurs="0" maxOccurs="2147483647"/>
				<xs:element ref="cellpopulations" minOccurs="0" maxOccurs="2147483647"/>
				<xs:element ref="bioinkgroup" minOccurs="0" maxOccurs="2147483647"/>
				<xs:element ref="process" minOccurs="0" maxOccurs="2147483647"/>
				<xs:element ref="protocol" minOccurs="0" maxOccurs="2147483647"/>
				<xs:element ref="results" minOccurs="0" maxOccurs="2147483647"/>
				<xs:element ref="fieldbinding" minOccurs="0" maxOccurs="2147483647"/>
				<xs:element ref="calibration" minOccurs="0" maxOccurs="2147483647"/>
				<xs:element ref="regulatory" minOccurs="0" maxOccurs="2147483647"/>
				<xs:element ref="openitems" minOccurs="0" maxOccurs="2147483647"/>
				<xs:element ref="printheads" minOccurs="0" maxOccurs="2147483647"/>
				<xs:element ref="maturation" minOccurs="0" maxOccurs="2147483647"/>
				<xs:element ref="characterization" minOccurs="0" maxOccurs="2147483647"/>
				<xs:any namespace="##other" processContents="lax" minOccurs="0"
					maxOccurs="2147483647"/>
			</xs:choice>
		</xs:sequence>
		<xs:anyAttribute namespace="##other" processContents="lax"/>
	</xs:complexType>

	<!-- 1. Evidence -->

	<xs:complexType name="CT_Evidence">
		<xs:sequence>
			<xs:element ref="reference" minOccurs="1" maxOccurs="2147483647"/>
