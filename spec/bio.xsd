		<xs:attribute name="evid" type="ST_ResourceIDN"/>
		<xs:attribute name="evindices" type="ST_ResourceIndices"/>
		<xs:attribute name="method" type="xs:string"/>
		<xs:attribute name="n" type="ST_ResourceIndexN"/>
		<xs:attribute name="note" type="xs:string"/>
		<xs:anyAttribute namespace="##other" processContents="lax"/>
	</xs:complexType>

	<!-- 3. Substances -->

