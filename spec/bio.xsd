	<xs:complexType name="CT_Component">
		<xs:attribute name="substanceid" type="ST_ResourceID" use="required"/>
		<xs:attribute name="substanceindex" type="ST_ResourceIndex" use="required"/>
		<xs:attribute name="value" type="xs:string" use="required"/>
		<xs:attribute name="unit" type="xs:token" use="required"/>
