	<xs:complexType name="CT_CellLoad">
		<xs:attribute name="cellpopid" type="ST_ResourceID" use="required"/>
		<xs:attribute name="cellpopindex" type="ST_ResourceIndex" use="required"/>
		<!-- Exactly one of (density + unit) or fieldid MUST be present; see rule F3.
		     A uniform load is a scalar; a graded load is a volumetric field. -->
		<xs:attribute name="density" type="xs:string"/>
		<xs:attribute name="unit" type="xs:token"/>
		<xs:attribute name="fieldid" type="ST_ResourceIDN"/>
		<xs:attribute name="provenance" type="ST_Provenance" use="required"/>
