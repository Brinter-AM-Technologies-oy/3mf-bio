	<!-- 6. Process -->

	<xs:complexType name="CT_Process">
		<xs:sequence>
			<xs:element ref="machine"/>
			<xs:element ref="parameters"/>
			<xs:element ref="environment" minOccurs="0"/>
			<xs:element ref="toolpath" minOccurs="0"/>
			<xs:any namespace="##other" processContents="lax" minOccurs="0" maxOccurs="2147483647"/>
		</xs:sequence>
		<xs:attribute name="id" type="ST_ResourceID" use="required"/>
		<xs:attribute name="modality" type="ST_Modality" use="required"/>
		<!-- Crosswalk to the seven ISO/ASTM 52900:2021 process categories. Bio modalities are
		     finer-grained than 52900, so this is many-to-one and informative, not normative. -->
		<xs:attribute name="iso52900" type="ST_ISO52900Category"/>
		<xs:attribute name="printheadsid" type="ST_ResourceIDN"/>
		<xs:attribute name="calibrationid" type="ST_ResourceIDN"/>
		<xs:attribute name="regulatoryid" type="ST_ResourceIDN"/>
		<xs:attribute name="evid" type="ST_ResourceIDN"/>
		<xs:attribute name="evindices" type="ST_ResourceIndices"/>
		<xs:anyAttribute namespace="##other" processContents="lax"/>
	</xs:complexType>

	<xs:complexType name="CT_Machine">
		<xs:attribute name="vendor" type="xs:string"/>
