	<!-- ISO 8601 duration offset from the end of printing: P0D is immediately post-print,
	     P7D is day 7, PT4H is four hours. Using a duration rather than a label keeps
	     timepoints orderable and comparable across packages. -->
	<xs:simpleType name="ST_Timepoint">
		<xs:union>
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:pattern value="P([0-9]+Y)?([0-9]+M)?([0-9]+W)?([0-9]+D)?(T([0-9]+H)?([0-9]+M)?([0-9]+(\.[0-9]+)?S)?)?"/>
				</xs:restriction>
			</xs:simpleType>
			<xs:simpleType><xs:restriction base="xs:string"><xs:length value="0"/></xs:restriction></xs:simpleType>
		</xs:union>
	</xs:simpleType>

